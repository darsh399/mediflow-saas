# Example environment variables for backend
# Copy to .env and fill values for local development

PORT=3000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/mydatabase
JWT_SECRET=your_jwt_secret_here
ACCESS_TOKEN_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_TOKEN_COOKIE_MAX_AGE_MS=604800000
ACCESS_TOKEN_COOKIE_MAX_AGE_MS=3600000
VISIT_RADIUS_METERS=15
FRONTEND_INVITE_URL=http://localhost:3000
